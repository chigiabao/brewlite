    {
      "name": "3. Success + Idempotency",
      "item": [
        {
          "name": "S1 pay order 1001 WALLET",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('SUCCEEDED + PAID', () => { pm.expect(b.status).to.eql('SUCCEEDED'); pm.expect(b.orderStatus).to.eql('PAID'); });",
                  "pm.test('amount from order', () => pm.expect(b.amount).to.eql(85000));",
                  "pm.collectionVariables.set('paymentId', b.paymentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "s1-order-1001" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1001,\n  \"method\": \"WALLET\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "S2 replay same key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('idempotentReplay true', () => pm.expect(b.idempotentReplay).to.eql(true));",
                  "pm.test('same paymentId', () => pm.expect(b.paymentId).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "s1-order-1001" }
