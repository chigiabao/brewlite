    {
      "name": "6. Concurrency (dung curl, xem mo ta)",
      "item": [
        {
          "name": "C1 two parallel requests same key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('manual: run curl snippet in description', () => pm.expect(true).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "c1-order-1005-race" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1005,\n  \"method\": \"WALLET\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "description": "Postman khong chay song song; dung lenh:\ncurl -s -w '\\n%{http_code}\\n' -X POST http://localhost:3001/payments -H 'Content-Type: application/json' -H 'Idempotency-Key: c1-race' -d '{\"orderId\":1005,\"method\":\"WALLET\"}' &\ncurl -s -w '\\n%{http_code}\\n' -X POST http://localhost:3001/payments -H 'Content-Type: application/json' -H 'Idempotency-Key: c1-race' -d '{\"orderId\":1005,\"method\":\"WALLET\"}' &\nwait\nKy vong: 1x200 + 1x409 PAYMENT_IN_PROGRESS, DB chi 1 payment cho order 1005."
          }
        }
      ]
