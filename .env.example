# Chỉ dùng giá trị mẫu trên máy local. Không commit mật khẩu thật.
POSTGRES_USER=brew
POSTGRES_PASSWORD=brew
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
JWT_SECRET=local-only-change-me-before-deploy
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
PAYMENT_PROVIDER=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Dùng riêng môi trường demo local; không bật trên hệ thống public.
MOCK_GATEWAY_TEST_MODE=false
# Khi test VNPay qua ngrok, đặt hai URL này theo public URL của backend tunnel.
VNPAY_RETURN_URL=http://localhost:3001/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3001/payments/vnpay/ipn
# Ví dụ khi có tunnel: https://<backend-public-host>/payments/vnpay/return
# IPN phải là URL backend public mà VNPay truy cập được.
ENABLE_ORDER_AUTO_CANCEL=true
ENABLE_STRIPE_REFUND=true
ORDER_PAYMENT_EXPIRY_MINUTES=30
CHECKOUT_SESSION_TTL_MINUTES=31
