# Chỉ dùng giá trị mẫu trên máy local. Không commit mật khẩu thật.
POSTGRES_USER=brew
POSTGRES_PASSWORD=brew
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
JWT_SECRET=local-only-change-me-before-deploy
# Dùng riêng môi trường demo local; không bật trên hệ thống public.
MOCK_GATEWAY_TEST_MODE=false
# Khi test VNPay qua ngrok, đặt hai URL này theo public URL của backend tunnel.
VNPAY_RETURN_URL=https://your-ngrok-domain.ngrok-free.app/payments/vnpay/return
VNPAY_IPN_URL=https://your-ngrok-domain.ngrok-free.app/payments/vnpay/ipn
