# Chỉ dùng giá trị mẫu trên máy local. Không commit mật khẩu thật.
POSTGRES_USER=brew
POSTGRES_PASSWORD=brew
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
JWT_SECRET=local-only-change-me-before-deploy
# Dùng riêng môi trường demo local; không bật trên hệ thống public.
# FIX 11: mặc định Docker chạy demo MOCK; sửa thành STRIPE nếu có key test.
PAYMENT_PROVIDER=MOCK
MOCK_GATEWAY_TEST_MODE=true
# Chỉ bắt buộc khi PAYMENT_PROVIDER=STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
